# Copy to .env and fill in. Never commit .env.
SECTORS_API_KEY=
# Stop paid calls once the local ledger reaches this total.
CREDIT_HARD_CAP=950
# Credits already used before the ledger existed (check the Sectors portal).
CREDIT_OFFSET=0
# Optional LLM for claim extraction. Set any of these; without one, a rule-based extractor runs.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Which one to use by default: anthropic, openai, gemini, or rules. Blank = first key found.
LLM_PROVIDER=
# Optional model overrides (defaults: claude-opus-5, gpt-5-mini, gemini-2.5-flash)
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
# Let web users enter their own key in the UI (sent per request, never stored). Set false
# on a shared deployment if you only want the server's keys used.
ALLOW_USER_KEYS=true
# Market side panels (IDX indices, movers, news; forex from ECB via Frankfurter). About 12
# credits per full refresh, at most every few hours; they stop while fewer than
# MARKET_CREDIT_RESERVE credits remain under the cap.
MARKET_PANELS=true
MARKET_CREDIT_RESERVE=100

# --- Chat bots (optional) ---
# Fact-checks each chat may run per hour; bots are public and checks spend credits.
BOT_CHECKS_PER_HOUR=20
# Link to the web app included in bot replies, e.g. https://neraca-fakta.example.com
PUBLIC_APP_URL=
# Telegram: create a bot with @BotFather, paste its token. Run with `make telegram`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup). The webhook
# is served at https://<your-public-host>/webhooks/whatsapp by the API server.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; enter the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App secret (App settings > Basic); used to verify webhook signatures.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# The bot's public number (e.g. 6281234567890), shown as a "Chat on WhatsApp" link in the web app.
WHATSAPP_DISPLAY_NUMBER=
# auto (live if SECTORS_API_KEY is set), live, or fixtures (offline, BBCA/TLKM/GOTO only)
DATA_SOURCE=auto
